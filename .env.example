# ==========================================
# ScholarBridge Institutional Website Configuration
# ==========================================

# Optional: External CRM webhook URL (e.g. Zapier, Make, HubSpot, or custom institutional CRM endpoint)
# If provided, all validated enquiries from /contact are dispatched here as JSON payloads.
CRM_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/your-institutional-webhook

# Optional: Resend API Key for dispatching email confirmations
# RESEND_API_KEY=re_your_api_key_here

# Optional: Institutional Admin Alert Email
ADMIN_NOTIFICATION_EMAIL=admissions@scholarbridge.edu.in

# Public site domain for canonical URLs and sitemap generation
NEXT_PUBLIC_SITE_URL=https://scholarbridge.edu.in
